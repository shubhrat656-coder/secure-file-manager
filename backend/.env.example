# ============================================================
#  The app runs with NO database setup by default (DB_CLIENT=sqlite).
#  You only need this file if you want to use MySQL instead.
# ============================================================

# ---- Database mode ----
# sqlite = local file database, zero setup (default)
# mysql  = a real MySQL server (local or cloud)
DB_CLIENT=sqlite
DB_FILE=./data/app.db

# ---- MySQL settings (only used when DB_CLIENT=mysql) ----
# Local MySQL (XAMPP / installer):  DB_HOST=localhost  DB_SSL=false
# Cloud MySQL (Aiven / Railway / TiDB): copy host, port and user from the
# provider console and set DB_SSL=true.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=secure_file_manager
DB_SSL=false

# ---- Server ----
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# ---- Auth ----
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# ---- Uploads ----
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
